# ===================================================================
# DayarPlus Landing Page (Project A) - Environment Configuration
# ===================================================================

# 1. Project B (Main App System) Provisioning API
# The backend endpoint that creates the building, units, and admin account.
VITE_PROVISIONING_API_URL=http://localhost:3000/api/v1/register-tenant
# In production on Cloudflare Pages:
# VITE_PROVISIONING_API_URL=https://app.dayarplus.com/api/v1/register-tenant

# 2. Shared Security API Key (X-API-KEY header)
# Must match Project B's PROVISIONING_API_KEY environment variable.
VITE_PROVISIONING_API_KEY=dp-secret-onboarding-key-2026

# 3. Main Web Application URL (Project B Frontend)
# Base URL for SSO handoff redirect to the Onboarding Wizard (/onboard?token=...)
VITE_APP_URL=http://localhost:5173
# In production:
# VITE_APP_URL=https://app.dayarplus.com

# 4. Payment Gateway Configuration (PCI-DSS Hosted Fields / Iframe)
VITE_PAYMENT_GATEWAY_PROVIDER=meshulam
# Options: meshulam | tranzila | cardcom | stripe
VITE_PAYMENT_PUBLIC_KEY=pk_test_dayarplus_public_key_2026
VITE_PAYMENT_TERMINAL_ID=999888
